<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.toktik">

    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:label="toktik"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- La MainActivity NO tiene filtro LAUNCHER a proposito: se puede
             iniciar directamente (adb / flutter run), pero no aparece en el
             launcher. Los iconos de temporada son activity-alias y siempre
             hay exactamente uno habilitado, de modo que solo se ve un icono.
             La MainActivity nunca se deshabilita para que `flutter run`
             siga funcionando al cambiar de temporada. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
        </activity>
        <!-- Iconos alternos por temporada (se activan desde Dart segun la fecha).
             Normal = @mipmap/ic_launcher (assets/img/img.jpg).
             Halloween = 3.jpg, Navidad = 2.jpg, San Valentin = 1.jpg. -->
        <activity-alias
            android:name=".NormalIcon"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="toktik"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".HalloweenIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_halloween"
            android:label="toktik"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ChristmasIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_christmas"
            android:label="toktik"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ValentineIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_valentine"
            android:label="toktik"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
